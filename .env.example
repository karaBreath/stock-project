# NEBULA config — คัดลอกเป็น .env แล้วแก้ค่าตามต้องการ (ห้าม commit .env)
# ถ้าไม่มีไฟล์ .env แอปก็รันได้ปกติ ใช้ค่าเริ่มต้นทั้งหมด

# --- เว็บเซิร์ฟเวอร์ ---
PORT=5000

# --- ฐานข้อมูล (ว่าง = เก็บที่ data/stock_app.db ในโฟลเดอร์โปรเจกต์) ---
# DB_PATH=

# --- เชื่อมกับระบบเทรด MT5 (volume-edge) ---
# รันบนเครื่องเดียวกัน: ใช้ 127.0.0.1 ได้เลย ไม่ต้องใส่กุญแจ
#   (volume-edge ถือว่าคำขอจาก 127.0.0.1 เป็นการใช้ในเครื่อง จึงไม่ขอกุญแจ)
VE_BASE_URL=http://127.0.0.1:8641
VE_AUTH_KEY=

# รันคนละเครื่อง / ผ่าน tunnel: ใช้ที่อยู่เว็บ + กุญแจเดียวกับ AUTH_KEY ของ volume-edge
# VE_BASE_URL=https://volume.twinpatta.com
# VE_AUTH_KEY=ใส่กุญแจที่นี่

# --- ตัวเก็บข้อมูลเบื้องหลัง (เครื่องเรียนรู้) ---
LEARN_AUTO=1
LEARN_INTERVAL=3600

# --- แจ้งเตือน LINE (ไม่บังคับ) ---
# LINE_CHANNEL_TOKEN=
# LINE_USER_ID=

# --- AI Advisory (ไม่บังคับ · ว่าง = ใช้โหมดกฎในตัว ไม่เสียเงิน) ---
# ANTHROPIC_API_KEY=
